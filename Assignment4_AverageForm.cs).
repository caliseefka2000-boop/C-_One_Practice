using System;
using System.Windows.Forms;

namespace Home_Assignment
{
    public partial class Assignment4_AverageForm : Form
    {
        public Assignment4_AverageForm()
        {
            InitializeComponent();
        }

        private void btnCalculate_Click(object sender, EventArgs e)
        {
            try
            {
                double score1, score2, score3, score4, score5;

                if (!double.TryParse(txtScore1.Text, out score1) || score1 < 0 || score1 > 100)
                {
                    MessageBox.Show("Fadlan geli dhibco sax ah (0 - 100) Imtixaanka 1aad.", "Input Error", MessageBoxButtons.OK, MessageBoxIcon.Error);
                    txtScore1.Focus();
                    return;
                }

                if (!double.TryParse(txtScore2.Text, out score2) || score2 < 0 || score2 > 100)
                {
                    MessageBox.Show("Fadlan geli dhibco sax ah (0 - 100) Imtixaanka 2aad.", "Input Error", MessageBoxButtons.OK, MessageBoxIcon.Error);
                    txtScore2.Focus();
                    return;
                }

                if (!double.TryParse(txtScore3.Text, out score3) || score3 < 0 || score3 > 100)
                {
                    MessageBox.Show("Fadlan geli dhibco sax ah (0 - 100) Imtixaanka 3aad.", "Input Error", MessageBoxButtons.OK, MessageBoxIcon.Error);
                    txtScore3.Focus();
                    return;
                }

                if (!double.TryParse(txtScore4.Text, out score4) || score4 < 0 || score4 > 100)
                {
                    MessageBox.Show("Fadlan geli dhibco sax ah (0 - 100) Imtixaanka 4aad.", "Input Error", MessageBoxButtons.OK, MessageBoxIcon.Error);
                    txtScore4.Focus();
                    return;
                }

                if (!double.TryParse(txtScore5.Text, out score5) || score5 < 0 || score5 > 100)
                {
                    MessageBox.Show("Fadlan geli dhibco sax ah (0 - 100) Imtixaanka 5aad.", "Input Error", MessageBoxButtons.OK, MessageBoxIcon.Error);
                    txtScore5.Focus();
                    return;
                }

                double average = (score1 + score2 + score3 + score4 + score5) / 5.0;

                lblAverageResult.Text = "Average Score: " + average.ToString("n2");
            }
            catch (Exception ex)
            {
                MessageBox.Show(ex.Message);
            }
        }

        private void btnClear_Click(object sender, EventArgs e)
        {
            txtScore1.Text = "";
            txtScore2.Text = "";
            txtScore3.Text = "";
            txtScore4.Text = "";
            txtScore5.Text = "";
            lblAverageResult.Text = "";
            txtScore1.Focus();
        }

        private void btnExit_Click(object sender, EventArgs e)
        {
            this.Close();
        }
    }
}
